# Security headers for every path. frame-ancestors/X-Frame-Options stop the
# app being framed (clickjacking a wallet prompt). No script-src CSP: Next's
# static export relies on inline scripts, and a strict policy would need
# per-build hashes.
/*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Next's generated OG route emits an extensionless file, so Cloudflare Pages
# serves it as application/octet-stream and social scrapers reject the card.
# Declare the real type.
/atlas/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=3600
