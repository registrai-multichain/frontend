{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "sync": "tsx scripts/sync.ts",
    "deploy": "python3 scripts/render-badges.py && next build && tsx scripts/write-public-redirects.ts && wrangler pages deploy out --project-name=registrai-web --branch=main",
    "deploy:builders": "python3 scripts/render-badges.py && next build && bash scripts/build-builders-site.sh && bash scripts/deploy-builders-site.sh",
    "typecheck": "tsc --noEmit && tsc --noEmit -p builders-site"
  },
  "dependencies": {
    "@circle-fin/adapter-solana-kit": "^1.6.3",
    "@circle-fin/adapter-viem-v2": "^1.18.0",
    "@circle-fin/bridge-kit": "^1.15.1",
    "@solana/kit": "^5.5.1",
    "@solana/web3.js": "^1.98.4",
    "d3-geo": "^3.1.1",
    "next": "^16.2.10",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "swr": "^2.4.2",
    "viem": "^2.55.4"
  },
  "devDependencies": {
    "@openzeppelin/merkle-tree": "^1.0.8",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^20",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/topojson-client": "^3.1.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.10",
    "postcss": "^8.5.21",
    "tailwindcss": "^3.4.1",
    "topojson-client": "^3.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^2.1.0",
    "world-atlas": "^2.0.2",
    "wrangler": "^4.90.1"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
