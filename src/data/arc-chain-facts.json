{
  "reviewed": "2026-10-23",
  "facts": [
    {
      "id": "mainnet",
      "text": "Circle launched the public Arc mainnet on 16 September 2026, after a private mainnet phase.",
      "source": "https://www.circle.com/pressroom/circle-launches-arc-mainnet-an-economic-operating-system-for-the-internet",
      "date": "2026-09-16"
    },
    {
      "id": "gas",
      "text": "USDC is Arc's native gas token. The native gas balance uses 18 decimals; the USDC ERC-20 interface at 0x3600…0000 uses 6 decimals.",
      "source": "https://docs.arc.io/arc/references/contract-addresses",
      "date": "2026-09-16"
    },
    {
      "id": "evm",
      "text": "Arc is EVM-compatible and targets Ethereum's Osaka hard fork as its baseline, including EIP-7702.",
      "source": "https://docs.arc.io/arc/references/evm-differences",
      "date": "2026-09-16"
    },
    {
      "id": "validators",
      "text": "Along with Circle, Arc's founding validators include BlackRock, DTCC, Galaxy, ICE, Mastercard, MoneyGram, SBI Group, Standard Chartered, Sumitomo Corporation, Visa and Worldpay, in a phased rollout.",
      "source": "https://www.circle.com/pressroom/circle-launches-arc-mainnet-an-economic-operating-system-for-the-internet",
      "date": "2026-09-16"
    },
    {
      "id": "consensus",
      "text": "Arc's consensus uses Malachite, a Tendermint BFT implementation, with a permissioned proof-of-authority validator set.",
      "source": "https://docs.arc.io/arc/concepts/consensus-layer",
      "date": "2026-09-16"
    },
    {
      "id": "pos",
      "text": "Circle said the network is exploring a future transition from proof of authority toward proof of stake in 2027.",
      "source": "https://www.circle.com/pressroom/circle-launches-arc-mainnet-an-economic-operating-system-for-the-internet",
      "date": "2026-09-16"
    },
    {
      "id": "token",
      "text": "Circle completed the genesis mint of the ARC token, its full initial supply of 10 billion; it said this is not a commitment to publicly launch ARC, and fees remain payable in USDC.",
      "source": "https://www.circle.com/pressroom/circle-launches-arc-mainnet-an-economic-operating-system-for-the-internet",
      "date": "2026-09-16"
    }
  ],
